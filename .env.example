# =============================================
# ShopMyUniform — Environment Variables
# =============================================
# Copy this file to .env and fill in the values.

# ---------- Database (Neon PostgreSQL) ----------
# Use the pooled connection string from your Neon dashboard.
# Append ?pgbouncer=true for connection pooling.
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/fashion_ecommerce?sslmode=require&pgbouncer=true"

# ---------- NextAuth.js ----------
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"

# ---------- Cloudinary (Image Uploads) ----------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
