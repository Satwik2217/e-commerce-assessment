# =============================================
# ShopMyUniform — Environment Variables
# =============================================
# Copy this file to .env and fill in the values.

# ---------- Database Connections ----------
# OPTION A: For Local PostgreSQL / Docker Compose setup:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fashion_ecommerce?schema=public"

# OPTION B: For Production / Neon Serverless PostgreSQL (with connection pooling):
# DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/fashion_ecommerce?sslmode=require&pgbouncer=true"

# ---------- NextAuth.js ----------
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"

# ---------- Cloudinary (Image Uploads) ----------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
